---
const divisions = [
  {
    title: 'Workshop equipment',
    description:
      'Equip your workshop with dependable, professional grade solutions built for precision, productivity, and long-term performance.',
    image: '/car background.svg',
  },
  {
    title: 'Service center equipment',
    description:
      'Streamline vehicle servicing with reliable equipment designed for accuracy, efficiency, and a better service experience.',
    image: '/car rapair.avif',
  },
  {
    title: 'Body shop equipment',
    description:
      'Professional solutions for body repair and refinishing, helping you deliver precise workmanship and quality results every time.',
    image: 'public/full-body-paint.jpg',
  },
];
---

<section id="home" class="px-4 pb-6 lg:px-8">
  <div class="mx-auto grid max-w-7xl grid-cols-1 gap-6 lg:grid-cols-2">

    <!-- Left card -->
    <div class="flex flex-col justify-between rounded-2xl bg-white p-8 lg:p-10">
      <div>
        <h1 class="text-3xl font-medium leading-tight text-ink sm:text-4xl">
          Workshop Equipment
        </h1>
        <h2 class="text-3xl font-extrabold leading-tight text-ink/40 sm:text-4xl">
          You Can Count On
        </h2>
        <p class="mt-4 max-w-md text-sm leading-relaxed text-body">
          Vehicle lifts, cleaning systems, tyre machinery and professional
          tools - serving Sri Lanka's workshops since 1999.
        </p>
        <div class="mt-6 flex flex-wrap items-center gap-3">
          <a href="/contact" class="rounded-full bg-black px-5 py-2.5 text-sm font-semibold text-white hover:bg-gray-800">
            Contact Us
          </a>
          <a href="/products" class="rounded-full border border-ink/20 px-5 py-2.5 text-sm font-semibold text-ink hover:border-ink/40">
            View our products
          </a>
        </div>
      </div>

      

      <ul class="mt-10 space-y-3">
        {
          divisions.map((division, index) => (
            <li>
              <button
                type="button"
                class="division-card w-full rounded-xl border border-ink/10 px-5 py-3.5 text-left"
                data-index={index}
              >
                <span class="block text-sm font-bold">{division.title}</span>
                <span class="mt-1 block text-xs leading-relaxed opacity-70">
                  {division.description}
                </span>
              </button>
            </li>
          ))
        }
      </ul>
    </div>

    <!-- Right: image showcase -->
    <div class="relative min-h-[420px] overflow-hidden rounded-2xl bg-black lg:min-h-0">
      {
        divisions.map((division, index) => (
          <img
            src={division.image}
            alt={division.title}
            class="hero-image absolute inset-0 h-full w-full object-cover"
            data-index={index}
          />
        ))
      }

      <div class="absolute bottom-5 left-1/2 flex -translate-x-1/2 gap-1.5">
        {
          divisions.map((_, index) => (
            <span class="dot h-1.5 w-1.5 rounded-full bg-white/40" data-index={index} />
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .division-card.active {
    background: black;
    color: white;
  }

  .hero-image {
    opacity: 0;
    transition: opacity 0.4s ease;
  }
  .hero-image.active {
    opacity: 1;
  }

  .dot {
    transition: all 0.2s ease;
  }
  .dot.active {
    width: 1rem;
    background: white;
  }
</style>

<script>
  const cards = document.querySelectorAll('.division-card');

  function activate(index: string) {
    // clear every active class, then set the ones matching this index
    document.querySelectorAll('.active').forEach((el) => el.classList.remove('active'));

    document.querySelector(`.division-card[data-index="${index}"]`)?.classList.add('active');
    document.querySelector(`.hero-image[data-index="${index}"]`)?.classList.add('active');
    document.querySelector(`.dot[data-index="${index}"]`)?.classList.add('active');
  }

  cards.forEach((card) => {
    card.addEventListener('mouseenter', () => activate(card.getAttribute('data-index')!));
  });

  // start with the first card active
  activate('0');
</script>