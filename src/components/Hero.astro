---
const tabs = [
  {
    title: 'Workshop equipment',
    description:
      'Equip your workshop with dependable, professional grade solutions built for precision, productivity, and long-term performance.',
    image: '/car background.svg',
  },
  {
    title: 'Service center equipment',
    description:
      'Streamline vehicle servicing with reliable equipment designed for accuracy, efficiency, and a better service experience.',
    image: '/car rapair.avif',
  },
  {
    title: 'Body shop equipment',
    description:
      'Professional solutions for body repair and refinishing, helping you deliver precise workmanship and quality results every time.',
    image: '/full-body-paint.jpg',
  },
];
---
<section id="home" class="px-4 pb-6 lg:px-8">
  <div class="mx-auto grid max-w-7xl grid-cols-1 gap-6 lg:grid-cols-2">
 
    <!-- Left card -->
    <div class="flex flex-col justify-between rounded-2xl bg-white p-8 lg:p-10">
      <div>
        <h1 class="text-3xl font-medium leading-tight text-ink sm:text-4xl">
          Workshop Equipment
        </h1>
        <h2 class="bg-gradient-to-r from-[#777777] to-[#b0b0b0] bg-clip-text text-3xl font-bold  text-transparent sm:text-4xl">
          You Can Count On
        </h2>
        <p class="mt-4 max-w-md text-sm leading-relaxed text-body">
          Vehicle lifts, cleaning systems, tyre machinery and professional
          tools - serving Sri Lanka's workshops since 1999.
        </p>
        <div class="mt-6 flex flex-wrap items-center gap-3">
          <a href="/contact" class="contact-btn rounded-2xl px-5 py-2.5 text-sm font-semibold text-white transition-opacity hover:opacity-90">
            Contact Us
          </a>
          <a href="/products" class="rounded-2xl border border-ink/20 px-5 py-2.5 text-sm font-semibold text-ink hover:border-ink/40">
            View our products
          </a>
        </div>
      </div>
 
      <ul class="mt-10 space-y-3">
        {
          tabs.map((tab, index) => (
            <li>
              <button
                type="button"
                class="tab-card w-full rounded-xl border border-ink/10 px-5 py-3.5 text-left"
                data-index={index}
              >
                <span class="block text-sm font-bold">{tab.title}</span>
                <span class="mt-1 block text-xs leading-relaxed opacity-70">
                  {tab.description}
                </span>
              </button>
            </li>
          ))
        }
      </ul>
    </div>
 
    <!-- Image showcase -->
    <div class="relative min-h-[420px] overflow-hidden rounded-2xl bg-black lg:min-h-0">
      {
        tabs.map((tab, index) => (
          <img
            src={tab.image}
            alt={tab.title}
            class="tab-image absolute inset-0 h-full w-full object-cover"
            data-index={index}
          />
        ))
      }
 
      <div class="absolute bottom-5 left-1/2 flex -translate-x-1/2 gap-1.5">
        {
          tabs.map((_, index) => (
            <span class="dot h-1.5 w-1.5 rounded-full bg-white/40" data-index={index} />
          ))
        }
      </div>
    </div>
  </div>
</section>
 
<style>

  .contact-btn {
  background: linear-gradient(100deg, #0a1a3f 0%, #0a0a0a 50%, #3a0f10 100%);
}

  .tab-card.active {
    background: black;
    color: white;
  }
 
  .tab-image {
    opacity: 0;
    transition: opacity 0.4s ease;
  }
  .tab-image.active {
    opacity: 1;
  }
 
  .dot {
    transition: all 0.2s ease;
  }
 
</style>
 
<script>
  const cards = document.querySelectorAll('.tab-card');
 
  function activate(index: string) {
    document.querySelectorAll('.active').forEach((el) => el.classList.remove('active'));
 
    document.querySelector(`.tab-card[data-index="${index}"]`)?.classList.add('active');
    document.querySelector(`.tab-image[data-index="${index}"]`)?.classList.add('active');
    document.querySelector(`.dot[data-index="${index}"]`)?.classList.add('active');
  }
 
  cards.forEach((card) => {
    card.addEventListener('mouseenter', () => activate(card.getAttribute('data-index')!));
  });
 
  activate('0');
</script>