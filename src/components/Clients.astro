---
const partners = [
  { name: 'Sunshine', logo: '/sunshine.svg' },
  { name: 'Toyota', logo: '/toyota-logo-png-30 1.svg' },
  { name: 'Jaguar', logo: '/Jaguar-Logo-PNG 1.svg' },
  { name: 'Dimo', logo: '/DIMO-Logo-1-removebg-preview 1.svg' },
  { name: 'Land Rover', logo: '/landrover.svg' },
  { name: 'DPMC', logo: '/DPMC.svg' },
];


const oneSlide = [...partners, ...partners, ...partners];
---

<section class="overflow-hidden py-10">
  <div class="logos relative">
    <div class="logos-slide">
      {
        oneSlide.map((partner) => (
          <span class="logo-item">
            <img src={partner.logo} alt={partner.name} />
          </span>
        ))
      }
    </div>
    <div class="logos-slide" aria-hidden="true">
      {
        oneSlide.map((partner) => (
          <span class="logo-item">
            <img src={partner.logo} alt={partner.name} />
          </span>
        ))
      }
    </div>
  </div>
</section>

<style>
  @keyframes slide {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-100%);
    }
  }

  .logos {
    overflow: hidden;
    white-space: nowrap;
  }

  .logos-slide {
    display: inline-block;
    animation: slide 40s linear infinite;
  }

  .logo-item {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 180px;
  }

  .logo-item img {
    height: 48px;
    width: auto;
    max-width: 140px;
    object-fit: contain;
    display: inline-block;
    vertical-align: middle;
    filter: brightness(0);
    opacity: 0.85;
    transition: opacity 0.3s ease, transform 0.3s ease;
  }

  
  
</style>