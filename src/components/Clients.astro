---
const clients = [
  { name: 'Sunshine', logo: '/sunshine.svg' },
  { name: 'Toyota', logo: '/toyota-logo-png-30 1.svg' },
  { name: 'Jaguar', logo: '/Jaguar-Logo-PNG 1.svg' },
  { name: 'Dimo', logo: '/DIMO-Logo-1-removebg-preview 1.svg' },
  { name: 'Land Rover', logo: '/landrover.svg' },
  { name: 'DPMC', logo: '/DPMC.svg' },
];

const oneSlide = [...clients, ...clients, ...clients];
---

<section id="projects" class="relative overflow-hidden py-20 text-white lg:py-24">
  <div class="pointer-events-none absolute inset-0" aria-hidden="true">
    <img src="/logo background.svg" alt="" class="h-full w-full object-cover" />
  </div>

  <div class="relative mx-auto max-w-6xl px-6 text-center">
    <h2 class="font-raleway text-3xl font-extrabold tracking-tight sm:text-4xl">Our Valuable Clients</h2>
    <p class="mt-2 text-lg text-white/60">Sample sub-heading text</p>
  </div>

  <div class="logos relative mt-14">
    <div class="logos-slide">
      {oneSlide.map((client) => (
        <span class="logo-item">
          <img src={client.logo} alt={client.name} />
        </span>
      ))}
    </div>
    <div class="logos-slide">
      {oneSlide.map((client) => (
        <span class="logo-item">
          <img src={client.logo} alt={client.name} />
        </span>
      ))}
    </div>
  </div>
</section>

<style>
  @keyframes slide {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-100%);
    }
  }

  .logos {
    overflow: hidden;
    white-space: nowrap;
  }

  .logos-slide {
    display: inline-block;
    animation: slide 45s linear infinite;
  }

  .logo-item:hover img {
  transform: scale(1.15);
}

  
  .logo-item {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 280px;
  }

  .logo-item img {
    height: 110px;
    width: auto;
    max-width: 140px;
    object-fit: contain;
    display: inline-block;
    vertical-align: middle;
    transition: transform 0.3s ease;
  }

  

  .logo-item::before,
.logo-item::after {
  content: '';
  position: absolute;
  top: -2px;
  bottom: -2px;
  width: 2px;
  background: rgba(255, 255, 255, 0.15);
  clip-path: polygon(50% 0%, 100% 18%, 100% 82%, 50% 100%, 0% 82%, 0% 18%);
}
  .logo-item::before {
    left: 0;
  }
  .logo-item::after {
    left: 8px;
  }
</style>