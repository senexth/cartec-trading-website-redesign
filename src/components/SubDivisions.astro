---
const clients = [
  { name: 'Jaguar', logo: '/Jaguar-Logo-PNG 1.svg' },
  { name: 'Toyota', logo: '/toyota-logo-png-30 1.svg' },
  { name: 'Dimo', logo: '/DIMO-Logo-1-removebg-preview 1.svg' },
  { name: 'Land Rover', logo: '/landrover.svg' },
  { name: 'DPMC', logo: '/DPMC.svg' },
  { name: 'Sunshine', logo: '/sunshine.svg' },
];


const decorSquares = Array.from({ length: 12 });
---

<section class="px-4 py-10 lg:px-8">
  <div class="mx-auto grid max-w-7xl  gap-3 lg:grid-cols-[minmax(0,540px)_1fr]">
    
    <div class="relative h-[450px] grid-cols-4 grid-rows-3 gap-3 lg:grid">
      {
        decorSquares.map((_, i) => (
          <div class="decor-square rounded-xl" />
        ))
      }

      
      <div class="decor-fade pointer-events-none absolute inset-0"></div>

      <!-- Text sits on top of the grid -->
      <div class="absolute inset-0 flex items-center justify-center px-8">
        <div class="max-w-xs text-left">
        <h2 class="text-2xl  text-ink">
          Our <span class="bg-gradient-to-r from-[#777777] to-[#b0b0b0] bg-clip-text text-3xl font-bold  text-transparent sm:text-4xl">Valuable Clients</span>
        </h2>
        <p class="mt-2 text-sm text-body">
          Supporting businesses across Sri Lanka with quality equipment they can count on.
        </p>
      </div>
    </div>
    </div>

  
    

    <!-- Right side expanding client cards -->
    <div class="client-row flex h-[450px] gap-2 overflow-hidden">
      {
        clients.map((client, index) => (
          <div
            class="client-card relative overflow-hidden rounded-2xl bg-black"
            data-first={index === 0}
          >
            <img src={client.logo} alt={client.name} class="client-logo" />
            <span class="client-name">{client.name}</span>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  /* background squares */
  .decor-square {
    background: #e4e3e3;
  }

  /*  squares fade*/
  .decor-fade {
    background: linear-gradient(
      to bottom,
      #f2f2f2 0%,
      transparent 20%,
      transparent 80%,
      #f2f2f2 100%
    );
  }

  
  .client-card {
    flex: 1 1 0;
    min-width: 70px;
    transition: flex-grow 0.5s ease;
    background: #05070d;
  }

  /* First card starts wider than the rest */
  .client-card[data-first='true'] {
    flex-grow: 2;
  }

  
  .client-row:hover .client-card[data-first='true']:not(:hover) {
    flex-grow: 1;
    background: #05070d;
  }

  .client-card:hover,
  .client-card[data-first='true'] {
    background-image: url('/blue_gradient_stripes.svg');
    background-size: cover;
    background-position: center;
  }

  .client-card:hover {
    flex-grow: 2;
  }

  
  .client-logo {
    position: absolute;
    inset: 0;
    margin: auto;
    height: 28px;
    width: auto;
    max-width: 60%;
    opacity: 0.7;
    transition: height 0.5s ease, opacity 0.5s ease;
  }
  .client-card:hover .client-logo,
  .client-card[data-first='true'] .client-logo {
    height: 72px;
    opacity: 1;
  }

  /* Name label , hidden by default */
  .client-name {
    position: absolute;
    bottom: 1rem;
    left: 1rem;
    font-size: 0.95rem;
    font-weight: 700;
    color: white;
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  .client-card:hover .client-name,
  .client-card[data-first='true'] .client-name {
    opacity: 1;
  }
</style>