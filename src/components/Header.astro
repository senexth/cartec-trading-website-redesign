---
const navLinks = [
  { label: 'Home', href: '#home' },
  { label: 'About us', href: '#about' },
  { label: 'Products', href: '#products' },
  { label: 'Projects', href: '#projects' },
  { label: 'Blog', href: '/blog' },
];
---

<header class="relative z-20">
  <div class="mx-auto flex max-w-7xl items-center justify-between px-6 py-6 lg:px-10">
    <a href="#home" class="flex items-center gap-2" aria-label="Cartec Trading home">
      <img src="/image 1.svg" alt="Cartec Trading" class="h-auto w-36" />
    </a>

    <nav class="hidden items-center gap-9 lg:flex" aria-label="Primary">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="text-sm font-medium text-ink/80 transition-colors hover:text-brand-blue"
        >
          {link.label}
        </a>
      ))}
    </nav>

    <a
      href="#contact"
      class="hidden items-center gap-2 rounded-pill bg-brand-blue px-6 py-3 text-sm font-semibold text-white transition-colors hover:bg-brand-blue-dark lg:inline-flex"
    >
      Contact
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
        <path d="M3.5 8h9M8.5 3.5 13 8l-4.5 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </a>

    <button
      type="button"
      class="inline-flex items-center justify-center rounded-md p-2 text-ink lg:hidden"
      aria-label="Open menu"
      id="menu-toggle"
    >
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" />
      </svg>
    </button>
  </div>
</header>
