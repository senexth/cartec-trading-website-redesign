---
import { Image } from 'astro:assets';
import autopLogo from '../assets/img6.png';
import yamadaLogo from '../assets/img2.png';
import stenhojLogo from '../assets/img3.png';
import heshbonLogo from '../assets/img4.png';
import bigRedJacksLogo from '../assets/img5.png';
import secondBigRedJacksLogo from '../assets/img1.png';

const partners = [
  { name: 'Autop Stenhøj', logo: autopLogo },
  { name: 'Yamada', logo: yamadaLogo },
  { name: 'Stenhøj', logo: stenhojLogo },
  { name: 'Heshbon', logo: heshbonLogo },
  { name: 'Big Red Jacks', logo: bigRedJacksLogo },
  { name: 'Big Red Jacks', logo: secondBigRedJacksLogo },
  
];
---

<section id="partners" class="pb-4">
+   <div class="partners-bg px-8 py-16 lg:px-16">
+     <div class="mx-auto grid min-h-[270px] max-w-7xl grid-cols-1 gap-12 lg:grid-cols-2 lg:gap-0">
 
      <!-- Left logo grid -->
      <div class="flex items-center">
        <ul class="grid w-full grid-cols-3 items-center justify-items-center gap-x-8 gap-y-10 lg:pr-16">
          {
            partners.map((partner) => (
              <li>
                <Image src={partner.logo} alt={partner.name} class="partner-logo" />
              </li>
            ))
          }
        </ul>
      </div>
 
      
      <div class="flex flex-col justify-center lg:border-l lg:border-white/20 lg:pl-16">
        <h2 class="text-3xl text-white sm:text-4xl">
          Our <span class="bg-gradient-to-r from-[#777777] to-[#f1f0f0] bg-clip-text text-3xl font-bold  text-transparent sm:text-4xl">Valuable Partners</span>
        </h2>
        <p class="mt-3 max-w-md text-sm leading-snug text-white">
          Trusted by leading automotive brands, workshops and institutions across Sri Lanka
        </p>
      </div>
 
    </div>
  </div>
</section>
 
<style>
 
    .partners-bg {
  background-color: #000;
  background-image:
    radial-gradient(rgba(255, 255, 255, 0.07) 1px, transparent 2px),
    radial-gradient(circle 220px at 15% 50%, rgba(20, 80, 170, 0.5), transparent);
  background-size: 12px 12px, auto;
}
  
 
  
  .partner-logo {
    height: 40px;
    width: auto;
    max-width: 130px;
    object-fit: contain;

  }
</style>